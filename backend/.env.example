# ---- Required -----------------------------------------------------------
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ---- Optional provider keys ----------------------------------------------
# These can also be entered securely from the desktop Settings dialog.
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=

# ---- Optional -----------------------------------------------------------
PORT=8787

# Where generated media is stored permanently and served from /files.
STORAGE_DRIVER=local
# STORAGE_DIR=../storage/files
# DB_PATH=../storage/app.db

# Give up on video jobs older than this many minutes.
VIDEO_TIMEOUT_MIN=15

# Default model IDs (all selectable/overridable in the UI).
DEFAULT_VIDEO_MODEL=bytedance/seedance-2.0-mini
DEFAULT_IMAGE_MODEL=google/gemini-2.5-flash-image
DEFAULT_AUDIO_MODEL=openai/gpt-4o-audio-preview
