{
  "name": "ai-gen-studio",
  "version": "1.1.17",
  "description": "Local-first multi-provider AI generation desktop studio",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/princehdec/ai-gen-studio.git"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "desktop": "electron .",
    "desktop:dist": "electron-builder --win nsis",
    "backend": "npm --prefix backend start",
    "check": "node --check electron/main.cjs && node --check electron/preload.cjs && node --check backend/src/server.js && node --check backend/src/providers/index.js && node --check backend/src/routes/enhance.js"
  },
  "devDependencies": {
    "electron": "^38.1.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.aigenstudio.desktop",
    "productName": "AI Gen Studio",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "princehdec",
        "repo": "ai-gen-studio",
        "releaseType": "release"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "backend/**",
      "frontend/**"
    ],
    "files": [
      "electron/**/*",
      "backend/**/*",
      "frontend/**/*",
      "!backend/.env",
      "!storage/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  }
}
